{
  "expo": {
    "name": "BiblioMari",
    "slug": "bibliomari",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B82F6"
      },
      "package": "com.bibliomari.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O BiblioMari precisa acessar suas fotos para selecionar capas de livros."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
